{
  "name": "gitakure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A peaceful countryside RPG whose valley grows from a real GitHub history.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "bun run scripts/build-assets.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  }
}